// Prisma schema for Supabase (PostgreSQL)
// Replace your existing schema.prisma with this when migrating to Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  appointments Appointment[]

  @@map("customers")
}

model Appointment {
  id                      String   @id @default(uuid()) @db.Uuid
  customerId              String   @map("customer_id") @db.Uuid
  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  customerName            String   @map("customer_name")
  phone                   String
  email                   String?
  serviceAddress          String   @map("service_address")
  jobType                 String   @map("job_type")
  jobDescription          String   @map("job_description")
  preferredWindow         String?  @map("preferred_window")
  notes                   String?
  
  status                  String   @default("Scheduled")
  scheduledArrivalWindow  String?  @map("scheduled_arrival_window")
  etaMinutes              Int?     @map("eta_minutes")
  
  cancellationReason      String?  @map("cancellation_reason")
  
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@index([customerId])
  @@index([phone])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("appointments")
}

model Setting {
  id                String   @id @default("default")
  businessName      String   @default("Plumber Pro Services") @map("business_name")
  businessPhone     String   @default("(555) 123-4567") @map("business_phone")
  businessEmail     String   @default("info@plumberpro.com") @map("business_email")
  businessAddress   String   @default("123 Main Street, Lansing, MI 48933") @map("business_address")
  pricingDrainClogLow     Int @default(150) @map("pricing_drain_clog_low")
  pricingDrainClogHigh    Int @default(300) @map("pricing_drain_clog_high")
  pricingWaterHeaterLow   Int @default(300) @map("pricing_water_heater_low")
  pricingWaterHeaterHigh  Int @default(800) @map("pricing_water_heater_high")
  pricingPipeLeakLow      Int @default(250) @map("pricing_pipe_leak_low")
  pricingPipeLeakHigh     Int @default(600) @map("pricing_pipe_leak_high")
  pricingToiletRepairLow  Int @default(150) @map("pricing_toilet_repair_low")
  pricingToiletRepairHigh Int @default(350) @map("pricing_toilet_repair_high")
  notifyNewAppointments   Boolean @default(true) @map("notify_new_appointments")
  notifyCancellations     Boolean @default(true) @map("notify_cancellations")
  notifyDailySummary      Boolean @default(false) @map("notify_daily_summary")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}
